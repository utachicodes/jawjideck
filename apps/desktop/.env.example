# Jawji GCS base URL the desktop app talks to for licensing/entitlements.
VITE_JAWJI_GCS_URL=https://jawji.space

# Same Firebase web app config as jawji-gcs's NEXT_PUBLIC_FIREBASE_* — these
# are public client values, not secrets. Copy them from jawji-gcs/.env.local
# (or the Firebase console) so signing in here produces a session for the
# same Firebase project/user as jawji-gcs and jawjideck's web dashboard.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
